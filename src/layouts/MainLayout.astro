---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PERSADA — Komunitas Anak Muda RW 12",
  description = "Mengenal PERSADA, program kegiatan, dan agenda komunitas anak muda RW 12.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>