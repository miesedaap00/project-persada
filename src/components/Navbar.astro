<header class="navbar" id="site-navbar">
  <a class="brand" href="#beranda" aria-label="PERSADA, kembali ke beranda">
    <img
      class="logo logo-light"
      src="/images/logo-persada-light.png"
      alt="Logo PERSADA"
    />
    <img
      class="logo logo-dark"
      src="/images/logo-persada-dark.png"
      alt="Logo PERSADA"
    />
  </a>

  <nav class="desktop-nav" aria-label="Navigasi utama">
    <a href="#beranda">Beranda</a>
    <a href="#tentang">Tentang Kami</a>
    <a href="#kegiatan">Kegiatan</a>
  </nav>

  <details class="mobile-nav">
    <summary aria-label="Buka menu navigasi">
      <span></span>
      <span></span>
      <span></span>
    </summary>

    <nav aria-label="Navigasi mobile">
      <a href="#beranda">Beranda</a>
      <a href="#tentang">Tentang Kami</a>
      <a href="#kegiatan">Kegiatan</a>
      <a href="#agenda">Agenda Mendatang</a>
    </nav>
  </details>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 92px;
    padding: 0 8.3%;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand .logo {
    display: block;
    width: 200px;
    height: auto;
    max-height: 150px;
    object-fit: contain;
    transition: opacity 200ms ease;
  }

  .logo-dark {
    display: none !important;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 44px;
    margin-right: 16%;
  }

  .desktop-nav a {
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 250ms ease;
  }

  .desktop-nav a:hover {
    opacity: 0.65;
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav summary {
    display: flex;
    width: 42px;
    height: 42px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary span {
    width: 22px;
    height: 2px;
    background: #fff;
    transition: background-color 250ms ease;
  }

  .mobile-nav nav {
    position: absolute;
    top: 50px;
    right: 0;
    display: grid;
    gap: 4px;
    width: 210px;
    padding: 12px;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 32px rgb(0 0 0 / 8%);
  }

  .mobile-nav nav a {
    padding: 12px;
    border-radius: 6px;
    color: #111;
    font-size: 14px;
    text-decoration: none;
  }

  .mobile-nav nav a:hover {
    background: #f1f1f1;
  }

  .navbar.scrolled {
    background: rgb(255 255 255 / 97%);
    border-bottom-color: #eeeeee;
    box-shadow: 0 4px 24px rgb(0 0 0 / 5%);
    backdrop-filter: blur(14px);
  }

  .navbar.scrolled .logo-light {
    display: none !important;
  }

  .navbar.scrolled .logo-dark {
    display: block !important;
  }

  .navbar.scrolled .desktop-nav a {
    color: #111;
  }

  .navbar.scrolled .mobile-nav summary span {
    background: #111;
  }

  @media (max-width: 640px) {
    .navbar {
      height: 76px;
      padding-inline: 6%;
    }

    .brand .logo {
      width: 100px;
      max-height: 48px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .brand .logo,
    .desktop-nav a,
    .mobile-nav summary span {
      transition: none;
    }
  }
</style>

<script>
  const navbar = document.querySelector("#site-navbar");

  if (navbar) {
    const updateNavbar = () => {
      navbar.classList.toggle("scrolled", window.scrollY > 40);
    };

    updateNavbar();

    window.addEventListener("scroll", updateNavbar, {
      passive: true,
    });
  }
</script>